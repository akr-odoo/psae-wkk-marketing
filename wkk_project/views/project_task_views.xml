<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.wkk.project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="task_settings_page" string="Settings">
                    <group>
                        <field name="invisible_project_stage_ids" widget="many2many_tags" groups="project.group_project_stages" domain="[('company_id', 'in', (company_id, False))]"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
