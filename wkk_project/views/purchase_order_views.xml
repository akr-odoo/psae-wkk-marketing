<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.wkk.project</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="attributes">
                <attribute name="string">Project Reference</attribute>
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//field[@name='date_order']/.." position="inside">
                <field name="project_type_id" domain="[('is_template', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
