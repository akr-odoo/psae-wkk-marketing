<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_insurance_category_list" model="ir.ui.view">
        <field name="name">hr.insurance.category.view.list</field>
        <field name="model">hr.insurance.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_insurance_category_form" model="ir.ui.view">
        <field name="name">hr.insurance.category.view.form</field>
        <field name="model">hr.insurance.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" placeholder="Provider's name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_insurance_category_filter" model="ir.ui.view">
        <field name="name">hr.insurance.category.search</field>
        <field name="model">hr.insurance.category</field>
        <field name="arch" type="xml">
            <search string="Search Providers">
                <field name="name" filter_domain="['|', ('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_insurance_category_views" model="ir.actions.act_window">
        <field name="name">Insurance Providers</field>
        <field name="res_model">hr.insurance.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Insurance Providers
            </p>
        </field>
    </record>
</odoo>
