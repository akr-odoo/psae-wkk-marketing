<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_dependent_dependent_list" model="ir.ui.view">
        <field name="name">hr.dependent.dependent.view.list</field>
        <field name="model">hr.dependent.dependent</field>
        <field name="arch" type="xml">
            <list string="Dependents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="relation_id"/>
                <field name="birthday"/>
                <field name="age"/>
                <field name="insurance_allocation_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_hr_dependent_dependent_form" model="ir.ui.view">
        <field name="name">hr.dependent.dependent.view.form</field>
        <field name="model">hr.dependent.dependent</field>
        <field name="arch" type="xml">
            <form string="Dependent">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" placeholder="e.g., Johnny Jr."/>
                        </h1>
                    </div>
                    <group>
                        <field name="employee_id"/>
                        <field name="relation_id"/>
                        <field name="birthday"/>
                        <field name="age"/>
                    </group>
                    <notebook>
                        <page name="Insurance Allocations">
                            <field name="insurance_allocation_ids" context="{'default_employee_id': employee_id}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_dependent_dependent_filter" model="ir.ui.view">
        <field name="name">hr.dependent.dependent.search</field>
        <field name="model">hr.dependent.dependent</field>
        <field name="arch" type="xml">
            <search string="Search Dependents">
                <field name="name" string="Dependent Name" filter_domain="['|', ('name', 'ilike', self)]"/>
                <field name="employee_id"/>
                <field name="relation_id"/>
                <field name="age"/>
                <separator/>
                <filter string="My Dependents" name="my_dependents" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Uninsured" name="uninsured" domain="[('insurance_allocation_ids', '=', False)]"/>
                <filter string="Birthday" name="birthday" date="birthday"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Relation" name="group_relation" context="{'group_by': 'relation_id'}"/>
                    <filter string="Birthday" name="group_birthday" context="{'group_by': 'birthday'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_dependent_dependent_views" model="ir.actions.act_window">
        <field name="name">Dependents</field>
        <field name="res_model">hr.dependent.dependent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Dependents
            </p>
        </field>
    </record>
</odoo>
