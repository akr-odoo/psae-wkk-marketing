<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hr_leave_view_form_inherit_wkk_hr" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.wkk.hr</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <div name="button_box">
                    <button class="oe_stat_button" string="Approval Request" name="action_view_approval_request" type="object" icon="fa-pencil-square-o" invisible="not approval_request_id"/>
                </div>
            </sheet>
            <xpath expr="(//button[@name='action_approve'])[1]" position="attributes">
                <attribute name="invisible" add="not request_approved" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='action_approve'])[2]" position="attributes">
                <attribute name="invisible" add="not request_approved" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
