<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_dependent_relation_list" model="ir.ui.view">
        <field name="name">hr.dependent.relation.view.list</field>
        <field name="model">hr.dependent.relation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_dependent_relation_form" model="ir.ui.view">
        <field name="name">hr.dependent.relation.view.form</field>
        <field name="model">hr.dependent.relation</field>
        <field name="arch" type="xml">
            <form string="Dependent Relation">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" placeholder="Relation..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_dependent_relation_filter" model="ir.ui.view">
        <field name="name">hr.dependent.relation.search</field>
        <field name="model">hr.dependent.relation</field>
        <field name="arch" type="xml">
            <search string="Search Dependent Relations">
                <field name="name" filter_domain="['|', ('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_dependent_relation_views" model="ir.actions.act_window">
        <field name="name">Dependent Relation</field>
        <field name="res_model">hr.dependent.relation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Dependent Relations
            </p>
        </field>
    </record>
</odoo>
