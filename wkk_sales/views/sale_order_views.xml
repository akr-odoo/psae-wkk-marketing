<odoo>
    <record id="view_order_form_inherit_wkk_sales" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.wkk.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='client_order_ref']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<group name="order_details" position="inside">
				<field name="client_order_ref" required="1"/>
			</group>
            <!-- Approval Dev -->
            <header position="inside">
                <field name="approval_request_id" invisible="1"/>
                <field name="requires_approval" invisible="1"/>
                <field name="can_current_user_approve" invisible="1"/>

                <!-- Request buttons -->
                <button name="action_create_approvals"
                        type="object" string="Request Approval"
                        invisible="approval_status in ['new', 'pending', 'approved'] or state in ['cancel', 'done'] or not requires_approval"
                        class="oe_highlight"/>

                <!-- Direct approve/reject buttons -->
                <button name="action_approve"
                        class="btn-success" type="object"
                        string="Approve"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
                <button name="action_reject"
                        class="btn-danger" type="object"
                        string="Reject"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
            </header>
            <header position="after">
                <header invisible="not approval_request_id">
                    <div>
                        <span style="font-weight: bold; margin-right: 2px; margin-left: 6px;">Approval Status: </span>
                        <field name="approval_status" widget="badge"/>
                    </div>
                </header>
            </header>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_approval_request"
                        icon="fa-check" invisible="not approval_request_id">
                    Approval(s)
                </button>
            </div>
            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='send_proforma']" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='quotation_send']" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="validity_date" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="date_order" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="order_line" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <group name="note_group" position="inside">
                <group class="oe_subtotal_footer d-flex order-1 order-lg-2 flex-column gap-0" name="company_total" invisible="company_currency_id == currency_id">
                    <span style="font-weight: bold;">Total (Company Currency):</span>
                    <field name="company_currency_id" invisible="1"/> <!-- Hidden field to ensure currency context -->
                    <field name="total_in_company_currency" widget="monetary" options="{'currency_field': 'company_currency_id'}" nolabel="1" style="font-weight: bold;"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
