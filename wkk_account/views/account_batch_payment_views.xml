<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.batch.payment.form.inherit.wkk.account</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_code" position="after">
                <field name="cheque_number" readonly="state != 'draft'"/>
                <field name="cheque_due_date" readonly="state != 'draft'"/>
                <field name="cheque_amount" readonly="state != 'draft'"/>
            </field>
            <field name="name" position="after">
                <label name="notification_label" for="notification_user_ids" string="Users to Notify"/>
                <div name="notification_block" class="o_row" readonly="state != 'draft'">
                    <field name="notification_user_ids" widget="many2many_tags"/>
                    <field name="notify_days_before"/>
                    <span>day(s) before</span>
                </div>
                <field name="cheque_bank_id" readonly="state != 'draft'"/>
                <field name="cheque_memo" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_batch_payment_tree_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.batch.payment.list.inherit.wkk.account</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_tree"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="cheque_number" readonly="state != 'draft'"/>
                <field name="cheque_due_date" readonly="state != 'draft'"/>
                <field name="cheque_amount" readonly="state != 'draft'"/>
                <field name="cheque_bank_id" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_batch_payment_search_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.batch.payment.search.inherit.wkk.account</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_search"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="cheque_number"/>
                <field name="cheque_amount"/>
                <field name="cheque_memo"/>
                <field name="cheque_bank_id"/>
                <separator/>
                <filter string="My Cheques to be Notified" name="my_cheques_to_notify" domain="[('notification_user_ids', 'in', [uid])]"/>
            </field>
            <filter name="group_by_state" position="after">
                <filter string="Cheque Bank" name="group_by_bank" context="{'group_by':'cheque_bank_id'}"/>
                <filter string="Cheque Due Date" name="group_by_due_date" context="{'group_by':'cheque_due_date'}"/>
            </filter>
        </field>
    </record>
</odoo>
