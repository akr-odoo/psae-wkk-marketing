<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.wkk.account</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <group name="group1" position="inside">
                <field name="cheque_number" invisible="not receive_cheque" readonly="state != 'draft'"/>
                <field name="cheque_due_date" invisible="not receive_cheque" readonly="state != 'draft'"/>
                <field name="cheque_amount" invisible="not receive_cheque" readonly="state != 'draft'"/>
            </group>
            <group name="group2" position="inside">
                <label name="notification_label" for="notification_user_ids" string="Users to Notify" invisible="not receive_cheque" readonly="state != 'draft'"/>
                <div name="notification_block" class="o_row" invisible="not receive_cheque" readonly="state != 'draft'">
                    <field name="notification_user_ids" widget="many2many_tags"/>
                    <field name="notify_days_before"/>
                    <span>day(s) before</span>
                </div>
                <field name="cheque_bank_id" invisible="not receive_cheque" readonly="state != 'draft'"/>
                <field name="cheque_memo" invisible="not receive_cheque" readonly="state != 'draft'"/>
            </group>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.wkk.account</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="cheque_number"/>
                <field name="cheque_due_date"/>
                <field name="cheque_amount"/>
                <field name="cheque_bank_id"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_inherit_wkk_account" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.wkk.account</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="cheque_number"/>
                <field name="cheque_amount"/>
                <field name="cheque_memo"/>
                <field name="cheque_bank_id"/>
                <separator/>
            </field>
            <filter name="date" position="after">
                <filter string="My Cheques to be Notified" name="my_cheques_to_notify" domain="[('notification_user_ids', 'in', [uid])]"/>
            </filter>
            <filter name="company" position="after">
                <filter string="Cheque Bank" name="group_by_bank" context="{'group_by':'cheque_bank_id'}"/>
                <filter string="Cheque Due Date" name="group_by_due_date" context="{'group_by':'cheque_due_date'}"/>
            </filter>
        </field>
    </record>
</odoo>
