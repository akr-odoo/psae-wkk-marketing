<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_move_form_inherit_wkk_account" model="ir.ui.view">
        <field name="name">view.move.form.inherit.wkk.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="approval_request_id" invisible="1"/>
                <field name="requires_approval" invisible="1"/>
                <field name="can_current_user_approve" invisible="1"/>

                <!-- Request buttons -->
                <button name="action_create_approvals"
                        type="object" string="Request Approval"
                        invisible="approval_status in ['new', 'pending', 'approved'] or state in ['cancel', 'done'] or not requires_approval"
                        class="oe_highlight"/>

                <!-- Direct approve/reject buttons -->
                <button name="action_approve"
                        class="btn-success" type="object"
                        string="Approve"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
                <button name="action_reject"
                        class="btn-danger" type="object"
                        string="Reject"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
            </header>
            <header position="after">
                <header invisible="not approval_request_id">
                    <div>
                        <span style="font-weight: bold; margin-right: 2px; margin-left: 6px;">Approval Status: </span>
                        <field name="approval_status" widget="badge"/>
                    </div>
                </header>
            </header>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_approval_request"
                        icon="fa-check" invisible="not approval_request_id">
                    Approval(s)
                </button>
            </div>
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_print_pdf'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_register_payment'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_register_payment'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_draft'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//div[hasclass('oe_title')]//field[@name='move_type']" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="ref" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="purchase_vendor_bill_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//field[@name='invoice_date'][1]" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_date'][2]" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or "/>
            </xpath>
            <field name="date" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="payment_reference" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="partner_bank_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="invoice_date_due" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="invoice_payment_term_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="delivery_date" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//div[@name='currency_div']//div//field[@name='currency_id']" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <field name="invoice_line_ids" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="journal_line_ids" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="invoice_incoterm_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="incoterm_location" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//group[@name='accounting_info_group']//field[@name='preferred_payment_method_line_id'][1]" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']//field[@name='preferred_payment_method_line_id'][2]" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <field name="auto_post" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//field[@name='ref'][2]" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <field name="invoice_user_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="team_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <xpath expr="//group[@id='other_tab_group']//field[@name='partner_bank_id']" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <xpath expr="//group[@id='other_tab_group']//field[@name='payment_reference']" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='delivery_date']" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </xpath>
            <field name="campaign_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="medium_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="source_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
        </field>
    </record>
</odoo>
