<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_move_form_inherit_wkk_account" model="ir.ui.view">
        <field name="name">view.move.form.inherit.wkk.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <!-- Print Delivery Note (customer invoices only, posted) -->
                <button name="action_print_delivery_note"
                    type="object" string="Print Delivery Note"
                    invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </header>
        </field>
    </record>
</odoo>
