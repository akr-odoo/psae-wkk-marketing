<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_notify_payment_cheque_due_date" model="ir.cron">
        <field name="name">Cheque Payment Notifier</field>
        <field name="model_id" ref="wkk_account.model_account_payment"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id">1</field>
        <field name="state">code</field>
        <field name="code">model._cron_notify_cheque_due_date()</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>

    <record id="ir_cron_notify_batch_payment_cheque_due_date" model="ir.cron">
        <field name="name">Cheque Batch Payment Notifier</field>
        <field name="model_id" ref="wkk_account.model_account_batch_payment"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id">1</field>
        <field name="state">code</field>
        <field name="code">model._cron_notify_cheque_due_date()</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>
</odoo>
