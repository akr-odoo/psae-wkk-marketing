<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_order_form_inherit_wkk_purchase" model="ir.ui.view">
        <field name="name">view.order.form.inherit.wkk.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="project_purchase.view_order_form_inherit_project_purchase"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="approval_request_id" invisible="1"/>
                <field name="requires_approval" invisible="1"/>
                <field name="can_current_user_approve" invisible="1"/>

                <!-- Request buttons -->
                <button name="action_create_approvals"
                        type="object" string="Request Approval"
                        invisible="approval_status in ['new', 'pending', 'approved'] or state in ['cancel', 'done'] or not requires_approval"
                        class="oe_highlight"/>

                <!-- Direct approve/reject buttons -->
                <button name="action_approve"
                        class="btn-success" type="object"
                        string="Approve"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
                <button name="action_reject"
                        class="btn-danger" type="object"
                        string="Reject"
                        invisible="not can_current_user_approve or approval_status != 'pending'"/>
            </header>
            <header position="after">
                <header invisible="not approval_request_id">
                    <div>
                        <span style="font-weight: bold; margin-right: 2px; margin-left: 6px;">Approval Status: </span>
                        <field name="approval_status" widget="badge"/>
                    </div>
                </header>
            </header>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_approval_request"
                        icon="fa-check" invisible="not approval_request_id">
                    Approval(s)
                </button>
            </div>
            <xpath expr="//button[@name='action_rfq_send'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_rfq_send'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_rfq_send'][3]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='print_quotation'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_confirm'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_confirm'][2]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_approve'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_draft'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_lock'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_unlock'][1]" position="attributes">
                <attribute name="invisible" add="not id or (approval_status != 'approved' and requires_approval)" separator=" or "/>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="partner_ref" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="date_order" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="date_planned" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="project_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="order_line" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="user_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="origin" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="payment_term_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="readonly" add="approval_status == 'pending'" separator=" or " />
            </field>

        </field>
    </record>
</odoo>
