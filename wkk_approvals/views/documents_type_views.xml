<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_documents_type_list" model="ir.ui.view">
        <field name="name">documents.type.view.list</field>
        <field name="model">documents.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_documents_type_form" model="ir.ui.view">
        <field name="name">documents.type.view.form</field>
        <field name="model">documents.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" placeholder="Type..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_documents_type_filter" model="ir.ui.view">
        <field name="name">documents.type.search</field>
        <field name="model">documents.type</field>
        <field name="arch" type="xml">
            <search string="Search Document Types">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_documents_type_views" model="ir.actions.act_window">
        <field name="name">Document Type</field>
        <field name="res_model">documents.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Document Types
            </p>
        </field>
    </record>
</odoo>
