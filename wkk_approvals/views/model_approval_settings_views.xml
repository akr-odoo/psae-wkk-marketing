<odoo>
    <data>
        <!-- List Views: -->
        <record id="view_model_approval_settings_list" model="ir.ui.view">
            <field name="name">model.approval.settings.list</field>
            <field name="model">model.approval.settings</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="0">
                    <field name="model_id" widget="many2one" options="{'no_create_edit': True}" required="1"/>
                    <field name="approval_enabled"/>
                    <field name="approval_category_id" widget="many2one" options="{'no_create': True}"
                        domain="['|', ('model_id', '=', False), ('model_id', '=', model_id)]"/>
                </list>
            </field>
        </record>

        <!-- Form Views: -->
        <record id="view_model_approval_settings_form" model="ir.ui.view">
            <field name="name">model.approval.settings.form</field>
            <field name="model">model.approval.settings</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="approval_enabled"/>
                                <field name="approval_category_id" widget="many2one" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="model_id" widget="many2one" options="{'no_create_edit': True}"/>
                                <field name="model_name"/> <!-- Needed for compute -->
                                <field name="model_description"/> <!-- Needed for compute -->
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action Windows: -->
        <record id="action_model_approval_settings" model="ir.actions.act_window">
            <field name="name">Model Approval Settings</field>
            <field name="res_model">model.approval.settings</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
