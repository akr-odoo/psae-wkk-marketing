<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_wkk_approvals" model="ir.ui.view">
        <field name="name">account.move.form.inherit.wkk.approvals</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="attributes">
                <attribute name="invisible" separator=" or " add="move_type in ('in_invoice', 'in_refund', 'in_receipt', 'out_invoice')"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="after">
                <field name="partner_id" widget="res_partner_many2one" nolabel="1"
                    context="{'res_partner_search_mode': 'supplier', 'show_address': 1, 'default_is_company': True, 'show_vat': True}"
                    domain="[('company_id', 'in', (False, company_id)), ('vendor_state', '=', 'approved')]"
                    options='{"no_quick_create": True}'
                    default_focus="1"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt', 'out_invoice')"
                    placeholder="Search a name or Tax ID..."
                    readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
