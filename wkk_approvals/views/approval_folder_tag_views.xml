<odoo>
    <record id="approval_folder_tag_view_list" model="ir.ui.view">
        <field name="name">approval.folder.tag.view.list</field>
        <field name="model">approval.folder.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="approval_folder_tag_view_form" model="ir.ui.view">
        <field name="name">approval.folder.tag.view.form</field>
        <field name="model">approval.folder.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Approval Folder"/>
                        <h1>
                            <field name="name" placeholder="E.g., Sales Folders"/>
                        </h1>
                    </div>
                    <group>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_folder_tags" model="ir.actions.act_window">
        <field name="name">Approval Folder Tags</field>
        <field name="res_model">approval.folder.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
