<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_product_line_view_list_inherit_wkk_approvals" model="ir.ui.view">
        <field name="name">approval.product.line.view.list.inherit.wkk_approvals</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="currency_id" column_invisible="1"/> <!-- needed for widget -->
            </field>
            <field name="quantity" position="after">
                <field name="price_unit"/>
                <field name="price_subtotal" />
                <field name="price_total" column_invisible="not parent.has_product_price" />
            </field>
        </field>
    </record>
</odoo>
