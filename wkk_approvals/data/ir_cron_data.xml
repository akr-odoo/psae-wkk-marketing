<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_check_vendor_expired_documents" model="ir.cron">
        <field name="name">Check Vendor Expired Documents</field>
        <field name="model_id" ref="wkk_approvals.model_res_partner"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id">1</field>
        <field name="state">code</field>
        <field name="code">model._cron_check_vendor_expired_documents()</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>

    <record id="ir_cron_notify_vendor_document_expiry" model="ir.cron">
        <field name="name">Vendor Document Expiry Notifier</field>
        <field name="model_id" ref="wkk_approvals.model_res_partner"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id">1</field>
        <field name="state">code</field>
        <field name="code">model._cron_notify_vendor_document_expiry()</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>

    <record id="ir_cron_notify_vendor_modified" model="ir.cron">
        <field name="name">Vendor Modified Notifier</field>
        <field name="model_id" ref="wkk_approvals.model_res_partner"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id">1</field>
        <field name="state">code</field>
        <field name="code">model._cron_notify_vendor_modified()</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
    </record>
</odoo>
